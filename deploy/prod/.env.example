APP_NAME="Portfolio Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# http until /opt/infra/traefik/prod has TLS/ACME configured
APP_URL=http://portfolio-admin.akmalkeisin.com
LOG_LEVEL=error

# must match /opt/infra/mariadb/prod (DB `prod`, user `prod`)
DB_CONNECTION=mariadb
DB_HOST=mariadb_prod
DB_PORT=3306
DB_DATABASE=prod
DB_USERNAME=prod
# DB_PASSWORD is not set here: it comes from secrets/db_password.txt

# Frontend URL for CORS (contact form submissions)
FRONTEND_URL=https://akmalkeisin.com

# Telegram notifications (bot token from @BotFather; chat ID via `php artisan telegram:chat-id`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Daily unread-message digest time (app timezone unless TELEGRAM_DIGEST_TZ is set)
TELEGRAM_DIGEST_AT=08:00
