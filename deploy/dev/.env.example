APP_NAME="Portfolio Admin"
APP_ENV=dev
APP_KEY=
APP_DEBUG=true
APP_URL=http://portfolio-admin.dev.akmalkeisin.com
LOG_LEVEL=debug

# /opt/infra/mariadb/dev over db-net; `private_portfolio` holds the existing
# dev data and `dev_user` is granted on it (see README)
DB_CONNECTION=mariadb
DB_HOST=mariadb_dev
DB_PORT=3306
DB_DATABASE=private_portfolio
DB_USERNAME=dev_user
DB_PASSWORD=dev_user_password

# Frontend URL for CORS (contact form submissions)
FRONTEND_URL=http://localhost:3000

# Telegram notifications (bot token from @BotFather; chat ID via `php artisan telegram:chat-id`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Daily unread-message digest time (app timezone unless TELEGRAM_DIGEST_TZ is set)
TELEGRAM_DIGEST_AT=08:00
